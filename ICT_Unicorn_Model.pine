//@version=5
// =============================================================================
//  ICT UNICORN MODEL  —  High Probability Entry Framework
// -----------------------------------------------------------------------------
//  The Unicorn forms when a Breaker Block overlaps with a Fair Value Gap (FVG).
//  This confluence creates a precision entry zone AFTER liquidity is taken and
//  market structure shifts.
//
//      Liquidity  ->  MSS  ->  Breaker + FVG overlap  ->  Retrace  ->  Expansion
//
//  Visuals reproduce the reference chart:
//      • Green shaded "Unicorn zone" (Breaker x FVG overlap)
//      • MSS (Market Structure Shift) line + label
//      • Breaker block box + label
//      • Overlapped FVG box + label
//      • PDH / PDL liquidity lines (red)
// =============================================================================

indicator("ICT Unicorn Model", "Unicorn", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================== INPUTS =======================================
grpS = "Structure / Narrative"
swingLen   = input.int(5,   "Swing Pivot Length",        minval = 2, group = grpS, tooltip = "Bars on each side used to confirm a swing high / low (liquidity).")
dispMult   = input.float(1.5,"Displacement Strength (ATR)",minval = 0, step = 0.1, group = grpS, tooltip = "Minimum body size (in ATR) for the MSS candle to count as displacement.")
needSweep  = input.bool(true,"Require Liquidity Sweep",  group = grpS, tooltip = "Only validate a Unicorn when liquidity was swept before the MSS (No narrative = No model).")
raidSwing  = input.bool(true, "Raid: Swing Highs/Lows",  group = grpS, tooltip = "Count a sweep of an intraday swing pivot as the liquidity raid.")
raidDay    = input.bool(false,"Raid: Previous Day H/L",  group = grpS, tooltip = "Count a sweep of the previous DAY high/low as the liquidity raid.")
raidWeek   = input.bool(true, "Raid: Previous Week H/L", group = grpS, tooltip = "Count a sweep of the previous WEEK high/low as the liquidity raid.")
raidMonth  = input.bool(true, "Raid: Previous Month H/L",group = grpS, tooltip = "Count a sweep of the previous MONTH high/low as the liquidity raid.")
raidMemBars= input.int(50, "Raid Memory (bars)", minval = 1, group = grpS, tooltip = "How long a sweep stays 'valid' as narrative while waiting for the MSS.")

grpU = "Unicorn Zone"
showUni    = input.bool(true, "Show Unicorn Zone",        group = grpU)
uniColor   = input.color(color.new(#26a65b, 72), "Unicorn Zone",  group = grpU)
uniBorder  = input.color(color.new(#26a65b, 40), "Zone Border",   group = grpU)
extendBars = input.int(25, "Extend Zone (bars)", minval = 1, group = grpU)

grpC = "Components"
showBreaker = input.bool(true, "Show Breaker Block", group = grpC)
breakerCol  = input.color(color.new(color.gray, 0),   "Breaker Outline", group = grpC)
showFvg     = input.bool(true, "Show Overlapped FVG", group = grpC)
fvgCol      = input.color(color.new(#26a65b, 80), "FVG Fill",        group = grpC)
showMss     = input.bool(true, "Show MSS Line",       group = grpC)
mssCol      = input.color(color.new(color.black, 0),  "MSS Line",     group = grpC)

grpL = "Liquidity — Previous Candle High / Low"
liqColor    = input.color(color.new(color.red, 0), "Line Color",  group = grpL)
liqStyleIn  = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpL)
liqWidth    = input.int(1, "Line Width", minval = 1, maxval = 4, group = grpL)
liqLabels   = input.bool(true, "Show Labels", group = grpL)
// Per-timeframe toggles
showPDH = input.bool(true,  "Previous Day High/Low (PDH/PDL)",    group = grpL)
showPWH = input.bool(false, "Previous Week High/Low (PWH/PWL)",   group = grpL)
showPMH = input.bool(false, "Previous Month High/Low (PMH/PML)",  group = grpL)
showPHH = input.bool(false, "Previous 4H High/Low (P4H/P4L)",     group = grpL)
showP1H = input.bool(false, "Previous 1H High/Low (P1H/P1L)",     group = grpL)

grpD = "Display / History"
useMaxLB   = input.bool(false, "Limit Max Lookback", group = grpD, tooltip = "When on, the indicator only detects/draws within the last N bars (keeps the chart light on long histories).")
maxLBbars  = input.int(2000, "Max Lookback (bars)", minval = 50, group = grpD)
maxSetups  = input.int(3, "Historical Setups on Chart", minval = 1, maxval = 50, group = grpD, tooltip = "How many of the most recent Unicorn setups to keep drawn. Older ones are removed.")

grpA = "Alerts"
_alerts    = input.bool(true, "Enable Unicorn Alerts",   group = grpA)
_liqAlerts = input.bool(true, "Enable Liquidity Sweep Alerts", group = grpA, tooltip = "Fire when price takes out an enabled Previous Candle High / Low.")

// ============================== HELPERS ======================================
atr = ta.atr(14)

// Previous completed candle high/low per timeframe (used for both drawing and
// for the liquidity-raid narrative).
[dH, dL] = request.security(syminfo.tickerid, "D",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mH, mL] = request.security(syminfo.tickerid, "M",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[fH, fL] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[oH, oL] = request.security(syminfo.tickerid, "60",  [high[1], low[1]], lookahead = barmerge.lookahead_on)

// Swing pivots = engineered liquidity (PDH / PDL / equal highs-lows analog)
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float swingHigh    = na   // active swing high to break for a bullish MSS
var float swingLow     = na   // active swing low to break for a bearish MSS
var int   swingHighBar = na
var int   swingLowBar  = na

if not na(ph)
    swingHigh    := ph
    swingHighBar := bar_index - swingLen
if not na(pl)
    swingLow    := pl
    swingLowBar := bar_index - swingLen

// Liquidity raid = price takes out a pool (swing pivot and/or a chosen HTF
// previous-candle high/low). A sell-side raid (low taken) sets up a bullish
// Unicorn; a buy-side raid (high taken) sets up a bearish Unicorn.
f_tookLo(float lvl) => not na(lvl) and low  < lvl and low[1]  >= lvl
f_tookHi(float lvl) => not na(lvl) and high > lvl and high[1] <= lvl

// Swing-pivot raid (wick beyond swing then close back inside)
swingRaidSell = raidSwing and not na(swingLow)  and low  < swingLow  and close > swingLow
swingRaidBuy  = raidSwing and not na(swingHigh) and high > swingHigh and close < swingHigh

// HTF previous-candle raids
sellRaid = swingRaidSell or (raidDay and f_tookLo(dL)) or (raidWeek and f_tookLo(wL)) or (raidMonth and f_tookLo(mL))
buyRaid  = swingRaidBuy  or (raidDay and f_tookHi(dH)) or (raidWeek and f_tookHi(wH)) or (raidMonth and f_tookHi(mH))

// Remember the most recent raid; it stays valid as narrative for raidMemBars.
var int sellRaidBar = na
var int buyRaidBar  = na
if sellRaid
    sellRaidBar := bar_index
if buyRaid
    buyRaidBar := bar_index
sweptSell = not na(sellRaidBar) and (bar_index - sellRaidBar) <= raidMemBars
sweptBuy  = not na(buyRaidBar)  and (bar_index - buyRaidBar)  <= raidMemBars

// Displacement candle (strong, intent-driven move)
bodyUp   = close > open and (close - open) > atr * dispMult
bodyDown = open > close and (open - close) > atr * dispMult

// ============================== MSS DETECTION ================================
// Bullish MSS: close breaks above the active swing high with displacement
mssBull = showMss and not na(swingHigh) and close > swingHigh and close[1] <= swingHigh and bodyUp
// Bearish MSS: close breaks below the active swing low with displacement
mssBear = showMss and not na(swingLow)  and close < swingLow  and close[1] >= swingLow  and bodyDown

// ============================== BREAKER + FVG OVERLAP =======================
// Most recent opposing candle before the displacement leg -> breaker block.
// Bullish breaker = last down-close candle; Bearish breaker = last up-close candle.
f_breaker(bool bull) =>
    float bTop = na
    float bBot = na
    for i = 1 to 10
        bearC = close[i] < open[i]
        bullC = close[i] > open[i]
        if bull and bearC
            bTop := math.max(open[i], high[i])
            bBot := math.min(close[i], low[i])
            break
        if not bull and bullC
            bTop := math.max(close[i], high[i])
            bBot := math.min(open[i], low[i])
            break
    [bTop, bBot]

// FVG measured on the displacement (3-candle imbalance around current bar)
fvgBullTop = low          // gap upper edge
fvgBullBot = high[2]      // gap lower edge
fvgBearTop = low[2]
fvgBearBot = high
isFvgBull  = low > high[2]
isFvgBear  = high < low[2]

// ---- Historical setup registry: keep only the last `maxSetups` on chart ----
var array<box>   setBoxes  = array.new<box>()
var array<line>  setLines  = array.new<line>()
var array<label> setLabels = array.new<label>()
var array<int>   boxSeq    = array.new<int>()
var array<int>   lineSeq   = array.new<int>()
var array<int>   labelSeq  = array.new<int>()
var int setupSeq = 0

f_regBox(box b) =>
    array.push(setBoxes, b)
    array.push(boxSeq, setupSeq)
f_regLine(line l) =>
    array.push(setLines, l)
    array.push(lineSeq, setupSeq)
f_regLabel(label la) =>
    array.push(setLabels, la)
    array.push(labelSeq, setupSeq)

f_prune() =>
    minKeep = setupSeq - maxSetups + 1
    i = 0
    while i < array.size(setBoxes)
        if array.get(boxSeq, i) < minKeep
            box.delete(array.get(setBoxes, i))
            array.remove(setBoxes, i)
            array.remove(boxSeq, i)
        else
            i += 1
    j = 0
    while j < array.size(setLines)
        if array.get(lineSeq, j) < minKeep
            line.delete(array.get(setLines, j))
            array.remove(setLines, j)
            array.remove(lineSeq, j)
        else
            j += 1
    k = 0
    while k < array.size(setLabels)
        if array.get(labelSeq, k) < minKeep
            label.delete(array.get(setLabels, k))
            array.remove(setLabels, k)
            array.remove(labelSeq, k)
        else
            k += 1

f_makeUnicorn(bool bull) =>
    [bTop, bBot] = f_breaker(bull)
    fTop = bull ? fvgBullTop : fvgBearTop
    fBot = bull ? fvgBullBot : fvgBearBot
    okFvg = bull ? isFvgBull : isFvgBear
    // Overlap of breaker range and FVG range = the Unicorn zone
    zTop = math.min(bTop, fTop)
    zBot = math.max(bBot, fBot)
    valid = not na(bTop) and okFvg and zTop > zBot
    [valid, zTop, zBot, bTop, bBot, fTop, fBot]

f_drawSetup(bool bull) =>
    [valid, zTop, zBot, bTop, bBot, fTop, fBot] = f_makeUnicorn(bull)
    if valid
        rightX = bar_index + extendBars
        // ---- Breaker block ----
        if showBreaker
            f_regBox(box.new(bar_index - 3, bTop, rightX, bBot, border_color = breakerCol, border_width = 1, bgcolor = color.new(color.gray, 92)))
            f_regLabel(label.new(bar_index - 3, bull ? bBot : bTop, "Breaker", style = label.style_label_up, color = color.new(color.gray, 100), textcolor = color.black, size = size.small))
        // ---- Overlapped FVG ----
        if showFvg
            f_regBox(box.new(bar_index - 2, fTop, rightX, fBot, border_color = na, bgcolor = fvgCol))
            f_regLabel(label.new(rightX, fBot, "Overlapped FVG", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.black, size = size.small))
        // ---- Unicorn zone (the overlap) ----
        if showUni
            f_regBox(box.new(bar_index - 3, zTop, rightX, zBot, border_color = uniBorder, border_width = 1, bgcolor = uniColor))
        true
    else
        false

// ============================== TRIGGER LOGIC ===============================
// Optional max-lookback gate keeps detection/drawing within the last N bars.
inLookback = not useMaxLB or (bar_index > last_bar_index - maxLBbars)
bullValid = mssBull and (not needSweep or sweptSell) and inLookback
bearValid = mssBear and (not needSweep or sweptBuy)  and inLookback

if bullValid
    setupSeq += 1
    drawn = f_drawSetup(true)
    if drawn
        if showMss
            f_regLine(line.new(swingHighBar, swingHigh, bar_index, swingHigh, color = mssCol, style = line.style_dashed, width = 1))
            f_regLabel(label.new(bar_index, swingHigh, "MSS", style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.black, size = size.small))
        sellRaidBar := na    // consume the narrative
        f_prune()
    else
        setupSeq -= 1        // nothing drawn, release the sequence number

if bearValid
    setupSeq += 1
    drawn = f_drawSetup(false)
    if drawn
        if showMss
            f_regLine(line.new(swingLowBar, swingLow, bar_index, swingLow, color = mssCol, style = line.style_dashed, width = 1))
            f_regLabel(label.new(bar_index, swingLow, "MSS", style = label.style_label_up, color = color.new(color.white, 100), textcolor = color.black, size = size.small))
        buyRaidBar := na
        f_prune()
    else
        setupSeq -= 1

// ============= LIQUIDITY — Toggleable Previous Candle High / Low ============
// Previous-candle high/low for any timeframe = liquidity pools to draw on.
// Levels (dH/dL ... oH/oL) are computed once up in HELPERS and reused here.
liqStyle = liqStyleIn == "Dashed" ? line.style_dashed : liqStyleIn == "Dotted" ? line.style_dotted : line.style_solid

// Draw (or refresh) a high/low pair on the last bar. Returns the handle set so
// each timeframe keeps its own persistent lines/labels across bars.
f_drawLevel(bool show, float hi, float lo, string tagHi, string tagLo, line lnHi, line lnLo, label lbHi, label lbLo) =>
    line.delete(lnHi)
    line.delete(lnLo)
    label.delete(lbHi)
    label.delete(lbLo)
    line  rHi = na
    line  rLo = na
    label aHi = na
    label aLo = na
    if show and not na(hi)
        leftX  = bar_index - 60
        rightX = bar_index + extendBars
        rHi := line.new(leftX, hi, rightX, hi, color = liqColor, style = liqStyle, width = liqWidth)
        rLo := line.new(leftX, lo, rightX, lo, color = liqColor, style = liqStyle, width = liqWidth)
        if liqLabels
            aHi := label.new(rightX, hi, tagHi, style = label.style_label_left, color = color.new(color.white, 100), textcolor = liqColor, size = size.small)
            aLo := label.new(rightX, lo, tagLo, style = label.style_label_left, color = color.new(color.white, 100), textcolor = liqColor, size = size.small)
    [rHi, rLo, aHi, aLo]

// One persistent handle-set per timeframe.
var line dHi = na
var line dLo = na
var label dLbH = na
var label dLbL = na
var line wHi = na
var line wLo = na
var label wLbH = na
var label wLbL = na
var line mHi = na
var line mLo = na
var label mLbH = na
var label mLbL = na
var line fHi = na
var line fLo = na
var label fLbH = na
var label fLbL = na
var line oHi = na
var line oLo = na
var label oLbH = na
var label oLbL = na

if barstate.islast
    [a1, a2, a3, a4] = f_drawLevel(showPDH, dH, dL, "PDH", "PDL", dHi, dLo, dLbH, dLbL)
    dHi  := a1
    dLo  := a2
    dLbH := a3
    dLbL := a4
    [b1, b2, b3, b4] = f_drawLevel(showPWH, wH, wL, "PWH", "PWL", wHi, wLo, wLbH, wLbL)
    wHi  := b1
    wLo  := b2
    wLbH := b3
    wLbL := b4
    [c1, c2, c3, c4] = f_drawLevel(showPMH, mH, mL, "PMH", "PML", mHi, mLo, mLbH, mLbL)
    mHi  := c1
    mLo  := c2
    mLbH := c3
    mLbL := c4
    [d1, d2, d3, d4] = f_drawLevel(showPHH, fH, fL, "P4H", "P4L", fHi, fLo, fLbH, fLbL)
    fHi  := d1
    fLo  := d2
    fLbH := d3
    fLbL := d4
    [e1, e2, e3, e4] = f_drawLevel(showP1H, oH, oL, "P1H", "P1L", oHi, oLo, oLbH, oLbL)
    oHi  := e1
    oLo  := e2
    oLbH := e3
    oLbL := e4

// ============================== ALERTS ======================================
// --- Unicorn model alerts ---
alertcondition(bullValid, "Bullish Unicorn", "Bullish ICT Unicorn formed (Breaker + FVG overlap after bullish MSS).")
alertcondition(bearValid, "Bearish Unicorn", "Bearish ICT Unicorn formed (Breaker + FVG overlap after bearish MSS).")
if _alerts and bullValid
    alert("Bullish ICT Unicorn — enter on retrace into the overlap. Stop below the Unicorn range.", alert.freq_once_per_bar_close)
if _alerts and bearValid
    alert("Bearish ICT Unicorn — enter on retrace into the overlap. Stop above the Unicorn range.", alert.freq_once_per_bar_close)

// --- Liquidity sweep alerts (only for enabled timeframes) ---
f_sweptHi(bool show, float lvl) => show and not na(lvl) and high > lvl and high[1] <= lvl
f_sweptLo(bool show, float lvl) => show and not na(lvl) and low  < lvl and low[1]  >= lvl

sweepPDH = f_sweptHi(showPDH, dH)
sweepPDL = f_sweptLo(showPDH, dL)
sweepPWH = f_sweptHi(showPWH, wH)
sweepPWL = f_sweptLo(showPWH, wL)
sweepPMH = f_sweptHi(showPMH, mH)
sweepPML = f_sweptLo(showPMH, mL)
sweepP4H = f_sweptHi(showPHH, fH)
sweepP4L = f_sweptLo(showPHH, fL)
sweepP1H = f_sweptHi(showP1H, oH)
sweepP1L = f_sweptLo(showP1H, oL)

anyHiSweep = sweepPDH or sweepPWH or sweepPMH or sweepP4H or sweepP1H
anyLoSweep = sweepPDL or sweepPWL or sweepPML or sweepP4L or sweepP1L

alertcondition(sweepPDH, "PDH Swept", "Previous Day High liquidity taken.")
alertcondition(sweepPDL, "PDL Swept", "Previous Day Low liquidity taken.")
alertcondition(sweepPWH, "PWH Swept", "Previous Week High liquidity taken.")
alertcondition(sweepPWL, "PWL Swept", "Previous Week Low liquidity taken.")
alertcondition(sweepPMH, "PMH Swept", "Previous Month High liquidity taken.")
alertcondition(sweepPML, "PML Swept", "Previous Month Low liquidity taken.")
alertcondition(anyHiSweep, "Any High Swept", "Buy-side liquidity taken (enabled previous-candle high).")
alertcondition(anyLoSweep, "Any Low Swept",  "Sell-side liquidity taken (enabled previous-candle low).")

if _liqAlerts and anyHiSweep
    alert("Buy-side liquidity swept — a previous-candle high was taken out.", alert.freq_once_per_bar_close)
if _liqAlerts and anyLoSweep
    alert("Sell-side liquidity swept — a previous-candle low was taken out.", alert.freq_once_per_bar_close)
