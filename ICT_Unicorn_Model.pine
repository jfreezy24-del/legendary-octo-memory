//@version=5
// =============================================================================
//  UNICORN MODEL  —  Fractal (HTF/LTF) + Standard-Deviation Projections
// -----------------------------------------------------------------------------
//  The Unicorn forms when a Breaker Block overlaps with a Fair Value Gap (FVG)
//  AFTER liquidity is taken and market structure shifts. This build pairs that
//  entry model with the fractal std-dev projection workflow:
//
//      Liquidity -> MSS -> Breaker + FVG overlap -> Retrace -> Expansion
//
//  Drawn elements:
//      • Green "Unicorn zone" (Breaker x FVG overlap) + Breaker level lines
//      • Overlapped FVG box, MSS line, C2 / BB labels
//      • Standard-deviation target ladder off the C1->C2 manipulation leg
//        (1 = C2 extreme, 0 = C1 origin, negatives = draw-on-liquidity targets)
//      • Target-zone highlight
//      • Fractal HTF candle panel (e.g. 1H candles beside a 5m chart) + bias
//      • Toggleable previous Day/Week/Month/4H/1H liquidity lines (swept-aware)
// =============================================================================

indicator("Unicorn Model — Fractal StdDev", "Unicorn", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================== INPUTS =======================================
grpS = "Structure / Narrative"
swingLen   = input.int(5,   "Swing Pivot Length",        minval = 2, group = grpS, tooltip = "Bars on each side used to confirm a swing high / low (liquidity).")
dispMult   = input.float(1.5,"Displacement Strength (ATR)",minval = 0, step = 0.1, group = grpS, tooltip = "Minimum body size (in ATR) for the MSS candle to count as displacement.")
needSweep  = input.bool(true,"Require Liquidity Sweep",  group = grpS, tooltip = "Only validate a Unicorn when liquidity was swept before the MSS (No narrative = No model).")
raidSwing  = input.bool(true, "Raid: Swing Highs/Lows",  group = grpS, tooltip = "Count a sweep of an intraday swing pivot as the liquidity raid.")
raidDay    = input.bool(false,"Raid: Previous Day H/L",  group = grpS, tooltip = "Count a sweep of the previous DAY high/low as the liquidity raid.")
raidWeek   = input.bool(true, "Raid: Previous Week H/L", group = grpS, tooltip = "Count a sweep of the previous WEEK high/low as the liquidity raid.")
raidMonth  = input.bool(true, "Raid: Previous Month H/L",group = grpS, tooltip = "Count a sweep of the previous MONTH high/low as the liquidity raid.")
raidMemBars= input.int(50, "Raid Memory (bars)", minval = 1, group = grpS, tooltip = "How long a sweep stays 'valid' as narrative while waiting for the MSS.")

grpU = "Unicorn Zone"
showUni    = input.bool(true, "Show Unicorn Zone",        group = grpU)
uniColor   = input.color(color.new(#a5d6b7, 55), "Unicorn Zone Fill", group = grpU)
uniBorder  = input.color(color.new(#a5d6b7, 30), "Zone Border",   group = grpU)
extendBars = input.int(25, "Extend Zone (bars)", minval = 1, group = grpU)

grpC = "Components"
showBreaker = input.bool(true, "Show Breaker Levels", group = grpC)
breakerCol  = input.color(color.new(color.black, 0),  "Breaker / Level Lines", group = grpC)
showFvg     = input.bool(true, "Show Overlapped FVG", group = grpC)
fvgCol      = input.color(color.new(#7fc99b, 65), "FVG Fill",        group = grpC)
showMss     = input.bool(true, "Show MSS Line",       group = grpC)
mssCol      = input.color(color.new(color.black, 0),  "MSS Line",     group = grpC)
txtColor    = input.color(color.new(color.black, 0),  "Label Text",   group = grpC)

grpCol = "Candle Coloring (photo style)"
colorCandles = input.bool(true, "Recolor Candles", group = grpCol, tooltip = "Paint candles green (up) / black (down) like the reference image.")
upCol = input.color(#26a65b, "Up Candle",   group = grpCol)
dnCol = input.color(#1c1c1c, "Down Candle", group = grpCol)

grpL = "Liquidity — Previous Candle High / Low"
liqColor    = input.color(color.new(color.red, 0),  "Line Color (unswept)", group = grpL)
raidedColor = input.color(color.new(color.gray, 30),"Line Color (raided)",  group = grpL, tooltip = "Color a level switches to once price has taken it out. Raided levels also become dashed.")
liqStyleIn  = input.string("Solid", "Line Style (unswept)", options = ["Solid", "Dashed", "Dotted"], group = grpL)
liqWidth    = input.int(1, "Line Width", minval = 1, maxval = 4, group = grpL)
liqLabels   = input.bool(true, "Show Labels", group = grpL)
// Per-timeframe toggles
showPDH = input.bool(true,  "Previous Day High/Low (PDH/PDL)",    group = grpL)
showPWH = input.bool(false, "Previous Week High/Low (PWH/PWL)",   group = grpL)
showPMH = input.bool(false, "Previous Month High/Low (PMH/PML)",  group = grpL)
showPHH = input.bool(false, "Previous 4H High/Low (P4H/P4L)",     group = grpL)
showP1H = input.bool(false, "Previous 1H High/Low (P1H/P1L)",     group = grpL)

grpD = "Display / History"
useMaxLB   = input.bool(false, "Limit Max Lookback", group = grpD, tooltip = "When on, the indicator only detects/draws within the last N bars (keeps the chart light on long histories).")
maxLBbars  = input.int(2000, "Max Lookback (bars)", minval = 50, group = grpD)
maxSetups  = input.int(3, "Historical Setups on Chart", minval = 1, maxval = 50, group = grpD, tooltip = "How many of the most recent Unicorn setups to keep drawn. Older ones are removed.")

grpDev = "Standard Deviation Targets"
showDev       = input.bool(true, "Show Std-Dev Projection", group = grpDev, tooltip = "Project standard-deviation multiples of the C1->C2 manipulation leg as targets.")
devLevels     = input.string("1, 0, -1, -2, -2.5", "Levels (C1→C2 multiples)", group = grpDev, tooltip = "Comma-separated multiples. 1 = C2 (manipulation extreme), 0 = C1 (origin), negatives = downside/upside draw-on-liquidity targets.")
devNeutralCol = input.color(color.new(color.gray, 0), "Level 0..1 Color", group = grpDev)
devTargetCol  = input.color(color.new(#e08a3c, 0),    "Target (negative) Color", group = grpDev)
devTickLen    = input.int(4, "Tick Length (bars)", minval = 1, group = grpDev)
showDevLabels = input.bool(true, "Show Level Labels", group = grpDev)
showTgtZone   = input.bool(true, "Highlight Target Zone", group = grpDev)
tgtZoneFrom   = input.float(-2.0, "Target Zone From (mult)", step = 0.1, group = grpDev)
tgtZoneTo     = input.float(-2.5, "Target Zone To (mult)",   step = 0.1, group = grpDev)
tgtZoneCol    = input.color(color.new(#e07ab5, 80), "Target Zone Fill", group = grpDev)
c2Col         = input.color(color.new(#e08a3c, 0),  "C2 / BB Label Color", group = grpDev)

grpF = "Fractal Pair (HTF candle panel)"
htfTf      = input.timeframe("60", "HTF Timeframe", group = grpF, tooltip = "Higher timeframe for the fractal candle panel + bias. Example: HTF 1H while charting the 5m LTF.")
showPanel  = input.bool(true, "Show HTF Candle Panel", group = grpF)
panelCount = input.int(8, "HTF Candles", minval = 1, maxval = 30, group = grpF)
panelGap   = input.int(12, "Gap From Price (bars)", minval = 1, group = grpF)
panelSpace = input.int(5, "Candle Spacing (bars)", minval = 2, group = grpF)
panelUpCol = input.color(#26a65b, "Panel Up Candle",   group = grpF)
panelDnCol = input.color(#1c1c1c, "Panel Down Candle", group = grpF)
showInfo   = input.bool(true, "Show Model Info Label", group = grpF)

grpA = "Alerts"
_alerts    = input.bool(true, "Enable Unicorn Alerts",   group = grpA)
_liqAlerts = input.bool(true, "Enable Liquidity Sweep Alerts", group = grpA, tooltip = "Fire when price takes out an enabled Previous Candle High / Low.")

// ============================== HELPERS ======================================
atr = ta.atr(14)

// Photo-style candle coloring (green up / black down).
barcolor(colorCandles ? (close >= open ? upCol : dnCol) : na)

// Previous completed candle high/low per timeframe (used for both drawing and
// for the liquidity-raid narrative).
[dH, dL] = request.security(syminfo.tickerid, "D",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mH, mL] = request.security(syminfo.tickerid, "M",   [high[1], low[1]], lookahead = barmerge.lookahead_on)
[fH, fL] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[oH, oL] = request.security(syminfo.tickerid, "60",  [high[1], low[1]], lookahead = barmerge.lookahead_on)

// Swing pivots = engineered liquidity (PDH / PDL / equal highs-lows analog)
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float swingHigh    = na   // active swing high to break for a bullish MSS
var float swingLow     = na   // active swing low to break for a bearish MSS
var int   swingHighBar = na
var int   swingLowBar  = na

if not na(ph)
    swingHigh    := ph
    swingHighBar := bar_index - swingLen
if not na(pl)
    swingLow    := pl
    swingLowBar := bar_index - swingLen

// Liquidity raid = price takes out a pool (swing pivot and/or a chosen HTF
// previous-candle high/low). A sell-side raid (low taken) sets up a bullish
// Unicorn; a buy-side raid (high taken) sets up a bearish Unicorn.
f_tookLo(float lvl) => not na(lvl) and low  < lvl and low[1]  >= lvl
f_tookHi(float lvl) => not na(lvl) and high > lvl and high[1] <= lvl

// Swing-pivot raid (wick beyond swing then close back inside)
swingRaidSell = raidSwing and not na(swingLow)  and low  < swingLow  and close > swingLow
swingRaidBuy  = raidSwing and not na(swingHigh) and high > swingHigh and close < swingHigh

// HTF previous-candle raids
sellRaid = swingRaidSell or (raidDay and f_tookLo(dL)) or (raidWeek and f_tookLo(wL)) or (raidMonth and f_tookLo(mL))
buyRaid  = swingRaidBuy  or (raidDay and f_tookHi(dH)) or (raidWeek and f_tookHi(wH)) or (raidMonth and f_tookHi(mH))

// Remember the most recent raid; it stays valid as narrative for raidMemBars.
var int sellRaidBar = na
var int buyRaidBar  = na
if sellRaid
    sellRaidBar := bar_index
if buyRaid
    buyRaidBar := bar_index
sweptSell = not na(sellRaidBar) and (bar_index - sellRaidBar) <= raidMemBars
sweptBuy  = not na(buyRaidBar)  and (bar_index - buyRaidBar)  <= raidMemBars

// ---- C2 manipulation extreme (level-1 anchor; 0 = the Unicorn zone) ----
// Bearish leg opens on a buy-side raid: C2 = manipulation high.
// Bullish leg opens on a sell-side raid: C2 = manipulation low.
var float bearC2 = na
var int   bearC2Bar = na
var float bullC2 = na
var int   bullC2Bar = na

if buyRaid
    bearC2 := high
    bearC2Bar := bar_index
else if sweptBuy and high > bearC2
    bearC2 := high
    bearC2Bar := bar_index

if sellRaid
    bullC2 := low
    bullC2Bar := bar_index
else if sweptSell and low < bullC2
    bullC2 := low
    bullC2Bar := bar_index

// Parse the std-dev level list once.
var array<float> devArr = array.new<float>()
if barstate.isfirst
    parts = str.split(devLevels, ",")
    for i = 0 to array.size(parts) - 1
        v = str.tonumber(str.replace_all(array.get(parts, i), " ", ""))
        if not na(v)
            array.push(devArr, v)

// Displacement candle (strong, intent-driven move)
bodyUp   = close > open and (close - open) > atr * dispMult
bodyDown = open > close and (open - close) > atr * dispMult

// ============================== MSS DETECTION ================================
// Bullish MSS: close breaks above the active swing high with displacement
mssBull = showMss and not na(swingHigh) and close > swingHigh and close[1] <= swingHigh and bodyUp
// Bearish MSS: close breaks below the active swing low with displacement
mssBear = showMss and not na(swingLow)  and close < swingLow  and close[1] >= swingLow  and bodyDown

// ============================== BREAKER + FVG OVERLAP =======================
// Most recent opposing candle before the displacement leg -> breaker block.
// Bullish breaker = last down-close candle; Bearish breaker = last up-close candle.
f_breaker(bool bull) =>
    float bTop = na
    float bBot = na
    for i = 1 to 10
        bearC = close[i] < open[i]
        bullC = close[i] > open[i]
        if bull and bearC
            bTop := math.max(open[i], high[i])
            bBot := math.min(close[i], low[i])
            break
        if not bull and bullC
            bTop := math.max(close[i], high[i])
            bBot := math.min(open[i], low[i])
            break
    [bTop, bBot]

// FVG measured on the displacement (3-candle imbalance around current bar)
fvgBullTop = low          // gap upper edge
fvgBullBot = high[2]      // gap lower edge
fvgBearTop = low[2]
fvgBearBot = high
isFvgBull  = low > high[2]
isFvgBear  = high < low[2]

// ---- Historical setup registry: keep only the last `maxSetups` on chart ----
var array<box>   setBoxes  = array.new<box>()
var array<line>  setLines  = array.new<line>()
var array<label> setLabels = array.new<label>()
var array<int>   boxSeq    = array.new<int>()
var array<int>   lineSeq   = array.new<int>()
var array<int>   labelSeq  = array.new<int>()
var int setupSeq = 0

f_regBox(box b) =>
    array.push(setBoxes, b)
    array.push(boxSeq, setupSeq)
f_regLine(line l) =>
    array.push(setLines, l)
    array.push(lineSeq, setupSeq)
f_regLabel(label la) =>
    array.push(setLabels, la)
    array.push(labelSeq, setupSeq)

f_prune() =>
    minKeep = setupSeq - maxSetups + 1
    i = 0
    while i < array.size(setBoxes)
        if array.get(boxSeq, i) < minKeep
            box.delete(array.get(setBoxes, i))
            array.remove(setBoxes, i)
            array.remove(boxSeq, i)
        else
            i += 1
    j = 0
    while j < array.size(setLines)
        if array.get(lineSeq, j) < minKeep
            line.delete(array.get(setLines, j))
            array.remove(setLines, j)
            array.remove(lineSeq, j)
        else
            j += 1
    k = 0
    while k < array.size(setLabels)
        if array.get(labelSeq, k) < minKeep
            label.delete(array.get(setLabels, k))
            array.remove(setLabels, k)
            array.remove(labelSeq, k)
        else
            k += 1

f_makeUnicorn(bool bull) =>
    [bTop, bBot] = f_breaker(bull)
    fTop = bull ? fvgBullTop : fvgBearTop
    fBot = bull ? fvgBullBot : fvgBearBot
    okFvg = bull ? isFvgBull : isFvgBear
    // Overlap of breaker range and FVG range = the Unicorn zone
    zTop = math.min(bTop, fTop)
    zBot = math.max(bBot, fBot)
    valid = not na(bTop) and okFvg and zTop > zBot
    [valid, zTop, zBot, bTop, bBot, fTop, fBot]

f_drawSetup(bool bull) =>
    [valid, zTop, zBot, bTop, bBot, fTop, fBot] = f_makeUnicorn(bull)
    if valid
        leftX  = bar_index - 4
        rightX = bar_index + extendBars
        // ---- Unicorn zone: the light-green overlap box (drawn first, behind) ----
        if showUni
            f_regBox(box.new(leftX, zTop, rightX, zBot, border_color = uniBorder, border_width = 1, bgcolor = uniColor))
        // ---- Overlapped FVG: subtle green fill inside the zone ----
        if showFvg
            f_regBox(box.new(leftX, fTop, rightX, fBot, border_color = na, bgcolor = fvgCol))
            f_regLabel(label.new(rightX, bull ? fBot : fTop, "Overlaped FVG", style = label.style_none, textcolor = txtColor, size = size.small))
        // ---- Breaker: black level lines through the zone (the lines in the photo) ----
        if showBreaker
            f_regLine(line.new(leftX, bTop, rightX, bTop, color = breakerCol, width = 1))
            f_regLine(line.new(leftX, bBot, rightX, bBot, color = breakerCol, width = 1))
            f_regLabel(label.new(leftX, bull ? bTop : bBot, "Breaker", style = label.style_none, textcolor = txtColor, size = size.small))
        true
    else
        false

// Standard-deviation projection anchored to the Unicorn zone + C2 / BB labels.
// 0 = the zone edge (entry/origin), 1 = C2 (manipulation extreme).
// levelPrice(m) = zone0 + m*(C2 - zone0)  =>  m=1 at C2, m=0 at zone, negatives = targets.
f_drawProjection(bool bull) =>
    [valid, zTop, zBot, bTop, bBot, fTop, fBot] = f_makeUnicorn(bull)
    c2 = bull ? bullC2 : bearC2
    c2bar = bull ? bullC2Bar : bearC2Bar
    zone0 = bull ? zBot : zTop     // zone edge nearest C2 = the 0 / entry anchor
    if showDev and valid and not na(c2) and not na(zone0) and c2 != zone0
        unit = c2 - zone0
        lx = bar_index + extendBars
        // C2 (manipulation extreme) and BB (breaker block at the zone) labels
        f_regLabel(label.new(c2bar, c2, "C2", style = label.style_none, textcolor = c2Col, size = size.small))
        f_regLabel(label.new(c2bar, zone0, "BB", style = label.style_none, textcolor = c2Col, size = size.small))
        // Target zone band (drawn behind the ticks)
        if showTgtZone
            pa = zone0 + tgtZoneFrom * unit
            pb = zone0 + tgtZoneTo * unit
            f_regBox(box.new(lx - devTickLen * 4, math.max(pa, pb), lx, math.min(pa, pb), border_color = na, bgcolor = tgtZoneCol))
        // Std-dev tick ladder
        for i = 0 to array.size(devArr) - 1
            m = array.get(devArr, i)
            price = zone0 + m * unit
            col = m < 0 ? devTargetCol : devNeutralCol
            f_regLine(line.new(lx - devTickLen, price, lx, price, color = col, width = 1))
            if showDevLabels
                f_regLabel(label.new(lx, price, str.tostring(m), style = label.style_none, textcolor = col, size = size.small))

// ============================== TRIGGER LOGIC ===============================
// Optional max-lookback gate keeps detection/drawing within the last N bars.
inLookback = not useMaxLB or (bar_index > last_bar_index - maxLBbars)
bullValid = mssBull and (not needSweep or sweptSell) and inLookback
bearValid = mssBear and (not needSweep or sweptBuy)  and inLookback

var int lastDir = 0   // 1 = last setup bullish, -1 = bearish, 0 = none (bias)

if bullValid
    setupSeq += 1
    drawn = f_drawSetup(true)
    if drawn
        if showMss
            f_regLine(line.new(swingHighBar, swingHigh, bar_index, swingHigh, color = mssCol, style = line.style_dashed, width = 1))
            f_regLabel(label.new(swingHighBar, swingHigh, "MSS", style = label.style_none, textcolor = txtColor, size = size.small))
        f_drawProjection(true)
        lastDir := 1
        sellRaidBar := na    // consume the narrative
        f_prune()
    else
        setupSeq -= 1        // nothing drawn, release the sequence number

if bearValid
    setupSeq += 1
    drawn = f_drawSetup(false)
    if drawn
        if showMss
            f_regLine(line.new(swingLowBar, swingLow, bar_index, swingLow, color = mssCol, style = line.style_dashed, width = 1))
            f_regLabel(label.new(swingLowBar, swingLow, "MSS", style = label.style_none, textcolor = txtColor, size = size.small))
        f_drawProjection(false)
        lastDir := -1
        buyRaidBar := na
        f_prune()
    else
        setupSeq -= 1

// ============= LIQUIDITY — Toggleable Previous Candle High / Low ============
// Previous-candle high/low for any timeframe = liquidity pools to draw on.
// Levels (dH/dL ... oH/oL) are computed once up in HELPERS and reused here.
liqStyle = liqStyleIn == "Dashed" ? line.style_dashed : liqStyleIn == "Dotted" ? line.style_dotted : line.style_solid

// Per-timeframe raid state: a side stays "raided" until a new period resets the
// level. Returns [hiRaided, loRaided]. One var-set per call site, so each
// timeframe gets independent memory.
f_lvlRaided(float lvlHi, float lvlLo) =>
    var float pHi = na
    var float pLo = na
    var bool  hiR = false
    var bool  loR = false
    if lvlHi != pHi
        pHi := lvlHi
        hiR := false
    if lvlLo != pLo
        pLo := lvlLo
        loR := false
    if not na(lvlHi) and high > lvlHi
        hiR := true
    if not na(lvlLo) and low < lvlLo
        loR := true
    [hiR, loR]

// Draw (or refresh) a high/low pair on the last bar. Solid + unswept color
// before the raid; dashed + raided color once taken. Returns the handle set so
// each timeframe keeps its own persistent lines/labels across bars.
f_drawLevel(bool show, float hi, float lo, string tagHi, string tagLo, bool hiRaided, bool loRaided, line lnHi, line lnLo, label lbHi, label lbLo) =>
    line.delete(lnHi)
    line.delete(lnLo)
    label.delete(lbHi)
    label.delete(lbLo)
    line  rHi = na
    line  rLo = na
    label aHi = na
    label aLo = na
    if show and not na(hi)
        leftX  = bar_index - 60
        rightX = bar_index + extendBars
        hiCol = hiRaided ? raidedColor : liqColor
        loCol = loRaided ? raidedColor : liqColor
        hiSty = hiRaided ? line.style_dashed : liqStyle
        loSty = loRaided ? line.style_dashed : liqStyle
        rHi := line.new(leftX, hi, rightX, hi, color = hiCol, style = hiSty, width = liqWidth)
        rLo := line.new(leftX, lo, rightX, lo, color = loCol, style = loSty, width = liqWidth)
        if liqLabels
            aHi := label.new(rightX, hi, tagHi, style = label.style_label_left, color = color.new(color.white, 100), textcolor = hiCol, size = size.small)
            aLo := label.new(rightX, lo, tagLo, style = label.style_label_left, color = color.new(color.white, 100), textcolor = loCol, size = size.small)
    [rHi, rLo, aHi, aLo]

// Evaluate raid state every bar (must be outside the islast block).
[dHiR, dLoR] = f_lvlRaided(dH, dL)
[wHiR, wLoR] = f_lvlRaided(wH, wL)
[mHiR, mLoR] = f_lvlRaided(mH, mL)
[fHiR, fLoR] = f_lvlRaided(fH, fL)
[oHiR, oLoR] = f_lvlRaided(oH, oL)

// One persistent handle-set per timeframe.
var line dHi = na
var line dLo = na
var label dLbH = na
var label dLbL = na
var line wHi = na
var line wLo = na
var label wLbH = na
var label wLbL = na
var line mHi = na
var line mLo = na
var label mLbH = na
var label mLbL = na
var line fHi = na
var line fLo = na
var label fLbH = na
var label fLbL = na
var line oHi = na
var line oLo = na
var label oLbH = na
var label oLbL = na

if barstate.islast
    [a1, a2, a3, a4] = f_drawLevel(showPDH, dH, dL, "PDH", "PDL", dHiR, dLoR, dHi, dLo, dLbH, dLbL)
    dHi  := a1
    dLo  := a2
    dLbH := a3
    dLbL := a4
    [b1, b2, b3, b4] = f_drawLevel(showPWH, wH, wL, "PWH", "PWL", wHiR, wLoR, wHi, wLo, wLbH, wLbL)
    wHi  := b1
    wLo  := b2
    wLbH := b3
    wLbL := b4
    [c1, c2, c3, c4] = f_drawLevel(showPMH, mH, mL, "PMH", "PML", mHiR, mLoR, mHi, mLo, mLbH, mLbL)
    mHi  := c1
    mLo  := c2
    mLbH := c3
    mLbL := c4
    [d1, d2, d3, d4] = f_drawLevel(showPHH, fH, fL, "P4H", "P4L", fHiR, fLoR, fHi, fLo, fLbH, fLbL)
    fHi  := d1
    fLo  := d2
    fLbH := d3
    fLbL := d4
    [e1, e2, e3, e4] = f_drawLevel(showP1H, oH, oL, "P1H", "P1L", oHiR, oLoR, oHi, oLo, oLbH, oLbL)
    oHi  := e1
    oLo  := e2
    oLbH := e3
    oLbL := e4

// ============= FRACTAL HTF CANDLE PANEL + MODEL INFO LABEL ==================
// Collect completed HTF candles into rolling arrays, then draw them as a mini
// candle panel to the right of price (the "5m – 1H" fractal view in the image).
[hO, hH, hL, hC, hT] = request.security(syminfo.tickerid, htfTf, [open, high, low, close, time], lookahead = barmerge.lookahead_off)

var array<float> paO = array.new<float>()
var array<float> paH = array.new<float>()
var array<float> paL = array.new<float>()
var array<float> paC = array.new<float>()
var array<int>   paT = array.new<int>()

htfRoll = hT != hT[1]
if htfRoll and not na(hO[1])
    array.push(paO, hO[1])
    array.push(paH, hH[1])
    array.push(paL, hL[1])
    array.push(paC, hC[1])
    array.push(paT, hT[1])
    while array.size(paO) > panelCount
        array.shift(paO)
        array.shift(paH)
        array.shift(paL)
        array.shift(paC)
        array.shift(paT)

var array<box>   panBoxes  = array.new<box>()
var array<line>  panWicks  = array.new<line>()
var array<label> panLabels = array.new<label>()
var label infoLbl = na

if barstate.islast
    // Clear previous panel
    for b in panBoxes
        box.delete(b)
    array.clear(panBoxes)
    for l in panWicks
        line.delete(l)
    array.clear(panWicks)
    for la in panLabels
        label.delete(la)
    array.clear(panLabels)
    if showPanel
        halfW = math.max(1, int(panelSpace / 2))
        for i = 0 to array.size(paO) - 1
            cx = bar_index + panelGap + i * panelSpace
            o = array.get(paO, i)
            c = array.get(paC, i)
            h = array.get(paH, i)
            l = array.get(paL, i)
            t = array.get(paT, i)
            col = c >= o ? panelUpCol : panelDnCol
            array.push(panWicks, line.new(cx, h, cx, l, color = col, width = 1))
            array.push(panBoxes, box.new(cx - halfW, math.max(o, c), cx + halfW, math.min(o, c), border_color = col, bgcolor = col))
            array.push(panLabels, label.new(cx, l, str.format_time(t, "HH:mm", syminfo.timezone), style = label.style_none, textcolor = txtColor, size = size.tiny))
    // Model info label
    label.delete(infoLbl)
    if showInfo
        biasTxt = lastDir == 1 ? "Bullish" : lastDir == -1 ? "Bearish" : "Neutral"
        infoLbl := label.new(bar_index, low, timeframe.period + " – " + htfTf + " Model\nBias: " + biasTxt, style = label.style_none, yloc = yloc.belowbar, textcolor = txtColor, size = size.normal)

// ============================== ALERTS ======================================
// --- Unicorn model alerts ---
alertcondition(bullValid, "Bullish Unicorn", "Bullish ICT Unicorn formed (Breaker + FVG overlap after bullish MSS).")
alertcondition(bearValid, "Bearish Unicorn", "Bearish ICT Unicorn formed (Breaker + FVG overlap after bearish MSS).")
if _alerts and bullValid
    alert("Bullish ICT Unicorn — enter on retrace into the overlap. Stop below the Unicorn range.", alert.freq_once_per_bar_close)
if _alerts and bearValid
    alert("Bearish ICT Unicorn — enter on retrace into the overlap. Stop above the Unicorn range.", alert.freq_once_per_bar_close)

// --- Liquidity sweep alerts (only for enabled timeframes) ---
f_sweptHi(bool show, float lvl) => show and not na(lvl) and high > lvl and high[1] <= lvl
f_sweptLo(bool show, float lvl) => show and not na(lvl) and low  < lvl and low[1]  >= lvl

sweepPDH = f_sweptHi(showPDH, dH)
sweepPDL = f_sweptLo(showPDH, dL)
sweepPWH = f_sweptHi(showPWH, wH)
sweepPWL = f_sweptLo(showPWH, wL)
sweepPMH = f_sweptHi(showPMH, mH)
sweepPML = f_sweptLo(showPMH, mL)
sweepP4H = f_sweptHi(showPHH, fH)
sweepP4L = f_sweptLo(showPHH, fL)
sweepP1H = f_sweptHi(showP1H, oH)
sweepP1L = f_sweptLo(showP1H, oL)

anyHiSweep = sweepPDH or sweepPWH or sweepPMH or sweepP4H or sweepP1H
anyLoSweep = sweepPDL or sweepPWL or sweepPML or sweepP4L or sweepP1L

alertcondition(sweepPDH, "PDH Swept", "Previous Day High liquidity taken.")
alertcondition(sweepPDL, "PDL Swept", "Previous Day Low liquidity taken.")
alertcondition(sweepPWH, "PWH Swept", "Previous Week High liquidity taken.")
alertcondition(sweepPWL, "PWL Swept", "Previous Week Low liquidity taken.")
alertcondition(sweepPMH, "PMH Swept", "Previous Month High liquidity taken.")
alertcondition(sweepPML, "PML Swept", "Previous Month Low liquidity taken.")
alertcondition(anyHiSweep, "Any High Swept", "Buy-side liquidity taken (enabled previous-candle high).")
alertcondition(anyLoSweep, "Any Low Swept",  "Sell-side liquidity taken (enabled previous-candle low).")

if _liqAlerts and anyHiSweep
    alert("Buy-side liquidity swept — a previous-candle high was taken out.", alert.freq_once_per_bar_close)
if _liqAlerts and anyLoSweep
    alert("Sell-side liquidity swept — a previous-candle low was taken out.", alert.freq_once_per_bar_close)
